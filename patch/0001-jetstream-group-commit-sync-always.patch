+func groupCommitServer(t *testing.T, syncAlways bool, atomic bool) (*Server, *stream, *fileStore, *nats.Conn, nats.JetStreamContext) {
+	t.Helper()
+	extra := ""
+	if syncAlways {
+		extra = "sync_interval: always"
+	}
+	conf := createConfFile(t, []byte(fmt.Sprintf(`
+		listen: 127.0.0.1:-1
+		jetstream: {
+			store_dir: %q
+			%s
+		}
+	`, t.TempDir(), extra)))
+	s, _ := RunServerWithConfig(conf)
+	nc, js := jsClientConnect(t, s)
+	_, err := jsStreamCreate(t, nc, &StreamConfig{
+		Name:               "TEST",
+		Subjects:           []string{"gc.>"},
+		Storage:            FileStorage,
+		Replicas:           1,
+		AllowAtomicPublish: atomic,
+	})
+	require_NoError(t, err)
+	mset, err := s.globalAccount().lookupStream("TEST")
+	require_NoError(t, err)
+	return s, mset, mset.store.(*fileStore), nc, js
+}
+
+// A burst of async publishes on a sync_interval: always stream must be acked in
+// order with contiguous sequences, fully stored, and leave the store in SyncAlways.
+func TestJetStreamGroupCommitSyncAlwaysAsyncBurst(t *testing.T) {
+	s, _, fs, nc, js := groupCommitServer(t, true, false)
+	defer s.Shutdown()
+	defer nc.Close()
+
+	const n = 2000
+	futures := make([]nats.PubAckFuture, 0, n)
+	for i := 0; i < n; i++ {
+		f, err := js.PublishAsync("gc.x", []byte(strconv.Itoa(i)))
+		require_NoError(t, err)
+		futures = append(futures, f)
+	}
+	select {
+	case <-js.PublishAsyncComplete():
+	case <-time.After(30 * time.Second):
+		t.Fatalf("timed out waiting for acks")
+	}
+	seen := make(map[uint64]bool, n)
+	for i, f := range futures {
+		select {
+		case pa := <-f.Ok():
+			if seen[pa.Sequence] {
+				t.Fatalf("duplicate sequence %d", pa.Sequence)
+			}
+			seen[pa.Sequence] = true
+			if pa.Sequence != uint64(i+1) {
+				t.Fatalf("publish %d acked with sequence %d, expected %d", i, pa.Sequence, i+1)
+			}
+		case err := <-f.Err():
+			t.Fatalf("publish %d failed: %v", i, err)
+		}
+	}
+	si, err := js.StreamInfo("TEST")
+	require_NoError(t, err)
+	require_Equal(t, si.State.Msgs, uint64(n))
+	require_Equal(t, si.State.LastSeq, uint64(n))
+	require_True(t, fs.syncAlways.Load())
+	require_False(t, fs.syncOnFlush.Load())
+}
+
+// An atomic batch arriving in the middle of a group must still commit as one unit,
+// and the surrounding ordinary messages must all be stored.
+func TestJetStreamGroupCommitAtomicBatchInterleaved(t *testing.T) {
+	s, _, fs, nc, js := groupCommitServer(t, true, true)
+	defer s.Shutdown()
+	defer nc.Close()
+
+	for i := 0; i < 500; i++ {
+		_, err := js.PublishAsync("gc.x", []byte("before"))
+		require_NoError(t, err)
+	}
+	for seq := 1; seq <= 3; seq++ {
+		m := nats.NewMsg("gc.batch")
+		m.Header.Set(JSBatchId, "b1")
+		m.Header.Set(JSBatchSeq, strconv.Itoa(seq))
+		if seq < 3 {
+			require_NoError(t, nc.PublishMsg(m))
+			continue
+		}
+		m.Header.Set(JSBatchCommit, "1")
+		resp, err := nc.RequestMsg(m, 10*time.Second)
+		require_NoError(t, err)
+		if !strings.Contains(string(resp.Data), `"count":3`) {
+			t.Fatalf("unexpected batch ack: %s", resp.Data)
+		}
+	}
+	for i := 0; i < 500; i++ {
+		_, err := js.PublishAsync("gc.x", []byte("after"))
+		require_NoError(t, err)
+	}
+	select {
+	case <-js.PublishAsyncComplete():
+	case <-time.After(30 * time.Second):
+		t.Fatalf("timed out waiting for acks")
+	}
+	si, err := js.StreamInfo("TEST")
+	require_NoError(t, err)
+	require_Equal(t, si.State.Msgs, uint64(1003))
+	require_True(t, fs.syncAlways.Load())
+	require_False(t, fs.syncOnFlush.Load())
+}
+
+// Grouping must engage only for sync_interval: always and must always release isolateMu.
+func TestJetStreamGroupCommitOnlyForSyncAlways(t *testing.T) {
+	for _, always := range []bool{true, false} {
+		t.Run(fmt.Sprintf("syncAlways=%v", always), func(t *testing.T) {
+			s, mset, fs, nc, _ := groupCommitServer(t, always, false)
+			defer s.Shutdown()
+			defer nc.Close()
+
+			gfs := mset.groupSyncBegin()
+			if !always {
+				require_True(t, gfs == nil)
+			} else {
+				require_True(t, gfs == fs)
+				require_True(t, fs.syncOnFlush.Load())
+				require_False(t, fs.syncAlways.Load())
+				require_True(t, mset.groupSyncEnd(gfs) == nil)
+				require_True(t, fs.syncAlways.Load())
+				require_False(t, fs.syncOnFlush.Load())
+			}
+			require_True(t, mset.isolateMu.TryLock())
+			mset.isolateMu.Unlock()
+		})
+	}
+}
