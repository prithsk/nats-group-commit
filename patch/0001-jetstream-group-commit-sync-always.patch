+// groupSyncBegin starts a group commit for a run of queued messages on a
+// single-server stream whose file store syncs every write (sync_interval: always).
+// It reuses the mechanism atomic batches use: switch the store to SyncOnFlush so
+// each write skips its own fsync, and hold isolateMu so direct reads cannot see
+// the run before it is durable. It returns nil when grouping does not apply.
+func (mset *stream) groupSyncBegin() *fileStore {
+	fs, ok := mset.store.(*fileStore)
+	// Lock-free check first so streams without sync_interval: always never take a lock here.
+	if !ok || !fs.syncAlways.Load() {
+		return nil
+	}
+	mset.isolateMu.Lock()
+	fs.mu.Lock()
+	if !fs.syncAlways.Load() {
+		fs.mu.Unlock()
+		mset.isolateMu.Unlock()
+		return nil
+	}
+	fs.updateDurabilitySettingsLocked(true)
+	fs.mu.Unlock()
+	return fs
+}
+
+// groupSyncEnd commits the run with a single flush and fsync, then restores
+// SyncAlways. Publish acks for the run are queued on mset.outq, and only
+// internalLoop drains that queue, so no ack reaches a client before this
+// fsync returns. If the fsync fails, the queued acks are dropped so the server
+// never acknowledges a write that may not be durable. Always returns nil.
+func (mset *stream) groupSyncEnd(fs *fileStore) *fileStore {
+	if fs == nil {
+		return nil
+	}
+	err := fs.FlushAllPending()
+	fs.mu.Lock()
+	fs.resetDurabilitySettingsLocked()
+	fs.mu.Unlock()
+	mset.isolateMu.Unlock()
+	if err != nil {
+		mset.setWriteErr(err)
+		if pms := mset.outq.pop(); pms != nil {
+			mset.outq.recycle(&pms)
+		}
+	}
+	return nil
+}
